# PostgreSQL Configuration
POSTGRES_USER=ritter_admin
POSTGRES_PASSWORD=change_me_in_production
POSTGRES_DB=ritter_nroetschen
DATABASE_URL=postgresql+asyncpg://ritter_app:change_me_app_password@db:5432/ritter_nroetschen

# JWT Authentication
JWT_SECRET_KEY=change_me_to_random_32_char_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Application Settings
DEBUG=false
HOST=0.0.0.0
PORT=8000

# Tradier Market Data
TRADIER_API_TOKEN=your_tradier_token_here
TRADIER_BASE_URL=https://api.tradier.com
