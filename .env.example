# PostgreSQL (Docker)
POSTGRES_USER=bamendjou
POSTGRES_PASSWORD=changeme
POSTGRES_DB=TradingAssistantDB

# Backend
# This value (localhost:5433) is for running the backend OUTSIDE Docker
# (e.g. `python -m uvicorn ...` — the normal day-to-day dev workflow), where
# 5433 is the host-side port docker-compose.yml maps the db container to.
# If you instead run the backend service INSIDE docker-compose (`docker
# compose up -d backend`), override DATABASE_URL to use the service name and
# in-network port instead:
#   postgresql+asyncpg://bamendjou:changeme@db:5432/TradingAssistantDB
DATABASE_URL=postgresql+asyncpg://bamendjou:changeme@localhost:5433/TradingAssistantDB
JWT_SECRET_KEY=replace-with-random-64-char-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
HOST=0.0.0.0
PORT=8000
DEBUG=false

# LAN access — open the app from another PC on your home network (opt-in).
# The API has NO authentication: anyone on the network who can reach port 8000
# can use it, including placing broker orders. Only enable on a trusted LAN.
#   1. Uncomment both lines below; use THIS PC's LAN IP in the origin.
#   2. Create frontend/.env.development.local (next dev) and/or
#      frontend/.env.production.local (npm run build - the live :3001 site),
#      both gitignored, containing
#        NEXT_PUBLIC_API_URL=http://<this-pc-lan-ip>:8000
#   3. Allow inbound TCP 8000 on the Private firewall profile, then restart
#      start-backend.bat and start-frontend.bat.
#   4. On the other PC, open http://<this-pc-lan-ip>:3001
# Keep the two sides in step: a frontend built with a LAN NEXT_PUBLIC_API_URL
# cannot reach a backend bound to 127.0.0.1 - every page then says the
# backend is offline, even on this PC.
# BAMENDJOU_BACKEND_BIND=0.0.0.0
# CORS_EXTRA_ORIGINS=http://<this-pc-lan-ip>:3001

# Tradier Market Data
TRADIER_API_TOKEN=your_tradier_token_here
TRADIER_BASE_URL=https://api.tradier.com

# Tiingo Historical Data (fixture generation only — not used at runtime)
TIINGO_API_TOKEN=your_tiingo_token_here

# Notification credentials — set these manually, never commit real values
BAMENDJOU_GMAIL_USER=
BAMENDJOU_GMAIL_PASSWORD=
BAMENDJOU_GMAIL_TO=
BAMENDJOU_TELEGRAM_BOT_TOKEN=
BAMENDJOU_TELEGRAM_CHAT_ID=
