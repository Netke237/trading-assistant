# Session / tool metadata (local settings/cache) — but track project-scoped skills so they travel with the repo
.claude/*
!.claude/skills/
# The SessionStart hook and its registration MUST be tracked: they are how every
# future session (and Kenneth's second account) gets the project-state check and
# the dependency install. Ignored, they exist only in whichever container made
# them -- which is the exact class of loss this repo has already suffered.
!.claude/hooks/
!.claude/settings.json
.superpowers/
.worktrees/
.opencode/
.playwright-mcp/
backend/audit.log
backend/*.log
backend/config/settings.yaml
backend/config/local_credentials.yaml
# Part 3 (scan-schedule) runtime data — real per-operator schedule entries,
# not committed config. tuning_schedule.yaml/ingestion_schedule.yaml/
# edgar_schedule.yaml/sp500_schedule.yaml are the same kind of runtime file
# and share this same gap today — pre-existing, out of scope here.
backend/config/scan_schedule.yaml

# SQLite WAL/SHM sidecars
*.db-shm
*.db-wal

# Test / Playwright artifacts
test-results/
frontend/test-results/
frontend/e2e/screenshots/
frontend/playwright-report/
llm-contexts/e2e-output.log

# Adversarial-audit scratch tests. Each round's auditor writes throwaway probe
# suites to verify a finding (a brute-force sweep, a multi-symbol round-trip);
# they are not coverage and must not land on a branch. Round 2's sweep did get
# committed and had to be removed again in 2d77017c. Name them `zz-scratch-*`
# and they stay out of the tree on their own.
zz-scratch-*.test.ts
zz-scratch-*.test.tsx
zzz_*.test.ts
zzz_*.test.tsx
